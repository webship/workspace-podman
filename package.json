{
  "name": "@webship.co/workspace-podman",
  "version": "1.0.0-alpha1",
  "description": "Podman for Webship Workspace: the PODMAN menu on every project with a compose file or a Containerfile (compose up/down/ps/logs, build and run the Containerfile, a shell, pods), the up/down caption. A runtime of @webship.co/workspace-container.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-podman.git"
  },
  "files": [
    "dist/src",
    "features",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "podman",
    "label": "Podman",
    "typeActions": {
      "podman": [
        "sites",
        "code"
      ]
    },
    "scripts": {
      "hostInstall": "scripts/host-install.sh"
    },
    "features": [
      "features/podman.feature"
    ]
  },
  "dependencies": {
    "@webship.co/workspace-container": "^1.0.0-alpha1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.0-alpha1",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
