{
  "name": "@webship.co/workspace-podman",
  "version": "1.0.10",
  "description": "Podman for Webship Workspace: the PODMAN menu on every project with a compose file or a Containerfile (compose up/down/ps/logs, build and run the Containerfile, a shell, pods), the up/down caption. It carries its AI items, each placed in the workspace folder of its kind: an agent, a skill, a command and a prompt. A runtime of @webship.co/workspace-container.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-podman.git"
  },
  "files": [
    "dist/src",
    "ai",
    "features",
    "scripts",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "podman",
    "label": "Podman",
    "needs": {
      "plugins": [
        "ai-agents",
        "ai-skills",
        "ai-commands",
        "ai-prompts"
      ],
      "commands": [
        {
          "command": "podman",
          "hint": "https://podman.io/docs/installation"
        }
      ]
    },
    "typeActions": {
      "podman": [
        "sites",
        "code"
      ]
    },
    "scripts": {
      "hostInstall": "scripts/host-install.sh"
    },
    "ai": {
      "agents": [
        "ai/agents/podman-operator.md"
      ],
      "skills": [
        "ai/skills/podman-menu"
      ],
      "commands": [
        "ai/commands/podman-status.md"
      ],
      "prompts": [
        "ai/prompts/podman-up-and-check.md"
      ]
    },
    "features": [
      "features/podman.feature"
    ]
  },
  "dependencies": {
    "@webship.co/workspace-container": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
